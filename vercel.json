{
  "buildCommand": "pnpm vercel-build",
  "outputDirectory": "dist/spa",
  "framework": null,
  "functions": {
    "api/enquiry.ts": {
      "memory": 256,
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/api/enquiry",
      "dest": "/api/enquiry"
    },
    {
      "src": "/api/(.*)",
      "status": 404
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
