{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist/spa" }
    },
    {
      "src": "api/enquiry.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/enquiry",
      "methods": ["POST"],
      "dest": "/api/enquiry.ts"
    },
    {
      "src": "/api/(.*)",
      "status": 404
    },
    {
      "src": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
