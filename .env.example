# Public Vite variables (safe to expose in the client bundle).
# Leave blank until Skylink-owned values exist. Never copy DataGram ids.

# Canonical site origin, no trailing slash (OD-10). Must be https:// with no path.
# Rejected: localhost, *.vercel.app preview hosts, http://, paths, or invented domains.
# Example once approved: https://www.example.com
VITE_SITE_URL=

# Production indexing gate (PH-10 / SEO-11). Default OFF when unset.
# Indexing is enabled only when ALL of the following are true:
#   1. Vercel deployment environment is production (VERCEL_ENV=production), and
#   2. VITE_ALLOW_INDEXING=true, and
#   3. VITE_SITE_URL is a valid approved HTTPS origin.
# Preview deployments stay noindex even if this flag is accidentally set.
# If this flag is true in a production SEO context but VITE_SITE_URL is invalid,
# the build fails closed instead of emitting fake canonical URLs or a sitemap.
# VITE_ALLOW_INDEXING=false

# Optional: force the production SEO path in local tests only (never on preview).
# SKYLINK_FORCE_PRODUCTION_SEO=true

# Google Analytics 4 measurement id for Skylink only (OD-13). PH-11 — leave blank.
VITE_GA_MEASUREMENT_ID=

# Optional Search Console HTML tag verification token (DNS preferred). OD-13.
VITE_GSC_VERIFICATION=

# Public Contact forms (PH-09). Default OFF when unset.
# Set to true only after OD-07 + OD-15 + CP-E, production delivery secrets,
# a verified server-side acceptance path, and an explicit go-live decision.
# The API still returns 503 when delivery is unconfigured — this flag only
# controls whether visitors see an active form UI.
# VITE_ENQUIRY_FORMS_ENABLED=false

# --- Server-only enquiry delivery (PH-08). Host env only — never VITE_* ---
# Modes: stub | email | webhook
# stub: accepts validated payloads in non-production only (NODE_ENV/VERCEL_ENV).
#       Production always treats stub as not configured → HTTP 503.
# email / webhook: require OD-07/OD-15 secrets; until a real adapter is wired
#       after CP-E, the API still returns 503 (no simulated success).
# ENQUIRY_DELIVERY_MODE=
# ENQUIRY_PROVIDER_API_KEY=
# ENQUIRY_TO_EMAIL=
# ENQUIRY_FROM_EMAIL=
# ENQUIRY_WEBHOOK_URL=
