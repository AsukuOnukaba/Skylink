# Public Vite variables (safe to expose in the client bundle).
# Leave blank until Skylink-owned values exist. Never copy DataGram ids.

# Canonical site origin, no trailing slash (OD-10). Example: https://www.example.com
VITE_SITE_URL=

# Google Analytics 4 measurement id for Skylink only (OD-13).
VITE_GA_MEASUREMENT_ID=

# Optional Search Console HTML tag verification token (DNS preferred).
VITE_GSC_VERIFICATION=

# Server-only secrets for POST /api/enquiry (PH-08). Set in the host env, not in VITE_*.
# ENQUIRY_PROVIDER_API_KEY=
# ENQUIRY_TO_EMAIL=
# ENQUIRY_FROM_EMAIL=
