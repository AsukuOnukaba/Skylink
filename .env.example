# Public Vite variables (safe to expose in the client bundle).
# Leave blank until Skylink-owned values exist. Never copy DataGram ids.

# Canonical site origin, no trailing slash (OD-10). Example: https://www.example.com
VITE_SITE_URL=

# Google Analytics 4 measurement id for Skylink only (OD-13).
VITE_GA_MEASUREMENT_ID=

# Optional Search Console HTML tag verification token (DNS preferred).
VITE_GSC_VERIFICATION=

# Public Contact forms (PH-09). Default OFF when unset.
# Set to true only after OD-07 + OD-15 + CP-E, production delivery secrets,
# a verified server-side acceptance path, and an explicit go-live decision.
# The API still returns 503 when delivery is unconfigured — this flag only
# controls whether visitors see an active form UI.
# VITE_ENQUIRY_FORMS_ENABLED=false

# --- Server-only enquiry delivery (PH-08). Host env only — never VITE_* ---
# Modes: stub | email | webhook
# stub: accepts validated payloads in non-production only (NODE_ENV/VERCEL_ENV).
#       Production always treats stub as not configured → HTTP 503.
# email / webhook: require OD-07/OD-15 secrets; until a real adapter is wired
#       after CP-E, the API still returns 503 (no simulated success).
# ENQUIRY_DELIVERY_MODE=
# ENQUIRY_PROVIDER_API_KEY=
# ENQUIRY_TO_EMAIL=
# ENQUIRY_FROM_EMAIL=
# ENQUIRY_WEBHOOK_URL=
